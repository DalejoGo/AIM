{
  "name": "repopage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && turbo run lint",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "bash scripts/ci/all.sh",
    "deploy:web": "bash scripts/deploy-web.sh",
    "db:migrate": "pnpm --filter @aim/edge db:migrate",
    "dev:full": "pnpm --filter @aim/web build && pnpm --filter @aim/web exec wrangler pages dev --ip 127.0.0.1 --port 8789",
    "knowledge": "node scripts/build-assistant-knowledge.mjs",
    "audit": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lighthouse": "13.5.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
