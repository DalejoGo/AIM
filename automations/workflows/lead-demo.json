              "id": "901e2824-204e-4961-8120-e1f590f9d0bd",
              "name": "checks",
              "value": "={{ ((R, lead) => [\n  { id: 'corporate_email', label: R.validation.labels.corporate_email, ok: !lead.email.split('@').pop().split('.').some((part) => R.validation.freeEmailProviders.includes(part)) },\n  { id: 'detailed_message', label: R.validation.labels.detailed_message, ok: lead.message.length >= R.validation.minMessageLength },\n  { id: 'company_given', label: R.validation.labels.company_given, ok: lead.company.length > 0 },\n  { id: 'no_suspicious_links', label: R.validation.labels.no_suspicious_links, ok: (lead.message.match(new RegExp(R.validation.linkPattern, 'gi')) ?? []).length <= R.validation.maxLinks }\n])($('Reglas del flujo').first().json, $('Preparar ejecución').first().json.lead) }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
