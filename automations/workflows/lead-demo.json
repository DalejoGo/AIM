      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cf028c9c-8935-4bf6-841f-14f6d4a6d177",
              "name": "runId",
              "value": "={{ String($json.body?.runId ?? '') }}",
              "type": "string"
            },
            {
              "id": "7c823d96-16a9-4324-9a9e-43672e41e9a6",
              "name": "callbackToken",
              "value": "={{ String($json.body?.callbackToken ?? '') }}",
              "type": "string"
            },
            {
              "id": "fbb152e3-8b6b-4af9-b791-455ccb870158",
              "name": "callbackUrl",
              "value": "={{ String($env.AIM_SITE_ORIGIN ?? '').replace(/\\/+$/, '') + '/api/automation/runs/' + encodeURIComponent(String($json.body?.runId ?? '')) + '/events' }}",
              "type": "string"
            },
            {
              "id": "a7f0e8a2-b715-4540-a08c-bf87358ff24b",
              "name": "requestOk",
              "value": "={{ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String($json.body?.runId ?? '')) && /^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/.test(String($json.body?.callbackToken ?? '')) && typeof $json.body?.lead === 'object' && $json.body?.lead !== null }}",
              "type": "boolean"
            },
            {
              "id": "0c363ffc-4aed-458a-bab3-2ef65334a21d",
              "name": "lead",
              "value": "={{ ((l) => ({ name: String(l.name ?? '').trim(), company: String(l.company ?? '').trim(), email: String(l.email ?? '').trim().toLowerCase(), service: String(l.service ?? ''), serviceTitle: String(l.serviceTitle ?? l.service ?? '').trim(), budget: String(l.budget ?? 'unknown'), timeline: String(l.timeline ?? 'flexible'), message: String(l.message ?? '').trim() }))($json.body?.lead ?? {}) }}",
              "type": "object"
            },
            {
              "id": "c4e4934c-9053-4e47-865e-0ff830cd99cc",
              "name": "vars",
              "value": "={{ ((l) => ({ firstName: String(l.name ?? '').trim().split(/\\s+/)[0], service: String(l.serviceTitle ?? l.service ?? '').trim(), fromCompany: String(l.company ?? '').trim() ? ' desde ' + String(l.company).trim() : '' }))($json.body?.lead ?? {}) }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
