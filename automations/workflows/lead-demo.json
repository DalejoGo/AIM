              "name": "factors",
              "value": "={{ ((R, lead, checks) => [\n  { label: R.factorLabels.budget + ': ' + (R.budgetLabels[lead.budget] ?? lead.budget), points: R.scoring.budget[lead.budget] ?? 0 },\n  { label: R.factorLabels.timeline + ': ' + (R.timelineLabels[lead.timeline] ?? lead.timeline), points: R.scoring.timeline[lead.timeline] ?? 0 },\n  { label: R.factorLabels.service + ': ' + lead.serviceTitle, points: R.scoring.service[lead.service] ?? R.scoring.service.other },\n  checks.find((check) => check.id === 'corporate_email').ok ? { label: R.factorLabels.corporateEmail, points: R.scoring.corporateEmail } : { label: R.factorLabels.personalEmail, points: 0 },\n  lead.message.length >= R.scoring.detailedMessageLength ? { label: R.factorLabels.detailedMessage, points: R.scoring.detailedMessage } : { label: R.factorLabels.shortMessage, points: 0 }\n])($('Reglas del flujo').first().json, $('Preparar ejecución').first().json.lead, $('Validar').first().json.checks) }}",
