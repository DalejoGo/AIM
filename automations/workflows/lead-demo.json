    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"validation\": {\n    \"freeEmailProviders\": [\n      \"gmail\",\n      \"hotmail\",\n      \"outlook\",\n      \"yahoo\",\n      \"icloud\"\n    ],\n    \"minMessageLength\": 40,\n    \"maxLinks\": 2,\n    \"linkPattern\": \"(https?://|www\\\\.)[^\\\\s]+\",\n    \"blockingChecks\": [\n      \"no_suspicious_links\"\n    ],\n    \"labels\": {\n      \"corporate_email\": \"Correo corporativo\",\n      \"detailed_message\": \"Mensaje con detalle\",\n      \"company_given\": \"Empresa indicada\",\n      \"no_suspicious_links\": \"Sin enlaces sospechosos\"\n    }\n  },\n  \"scoring\": {\n    \"budget\": {\n      \"lt500\": 5,\n      \"500-2000\": 15,\n      \"2000-5000\": 25,\n      \"gt5000\": 35,\n      \"unknown\": 10\n    },\n    \"timeline\": {\n      \"urgent\": 20,\n      \"month\": 15,\n      \"flexible\": 5\n    },\n    \"service\": {\n      \"automation\": 20,\n      \"app\": 20,\n      \"other\": 12\n    },\n    \"corporateEmail\": 10,\n    \"detailedMessage\": 15,\n    \"detailedMessageLength\": 80,\n    \"max\": 100,\n    \"tiers\": {\n      \"hot\": 70,\n      \"warm\": 40\n    }\n  },\n  \"factorLabels\": {\n    \"budget\": \"Presupuesto\",\n    \"timeline\": \"Plazo\",\n    \"service\": \"Servicio\",\n    \"corporateEmail\": \"Correo corporativo\",\n    \"personalEmail\": \"Correo personal\",\n    \"detailedMessage\": \"Mensaje detallado\",\n    \"shortMessage\": \"Mensaje breve\"\n  },\n  \"budgetLabels\": {\n    \"lt500\": \"menos de 500 USD\",\n    \"500-2000\": \"500 a 2.000 USD\",\n    \"2000-5000\": \"2.000 a 5.000 USD\",\n    \"gt5000\": \"más de 5.000 USD\",\n    \"unknown\": \"por definir\"\n  },\n  \"timelineLabels\": {\n    \"urgent\": \"urgente (menos de 2 semanas)\",\n    \"month\": \"de 1 a 2 meses\",\n    \"flexible\": \"flexible\"\n  },\n  \"routes\": {\n    \"hot\": {\n      \"route\": \"call\",\n      \"label\": \"Llamada en menos de 24 horas\",\n      \"sla\": \"24 horas\"\n    },\n    \"warm\": {\n      \"route\": \"proposal\",\n      \"label\": \"Propuesta por correo en 48 horas\",\n      \"sla\": \"48 horas\"\n    },\n    \"cold\": {\n      \"route\": \"nurture\",\n      \"label\": \"Secuencia de contenido útil\",\n      \"sla\": \"Primer envío en 7 días\"\n    }\n  },\n  \"drafts\": {\n    \"call\": {\n      \"subject\": \"{firstName}, hablemos de tu proyecto de {service}\",\n      \"body\": [\n        \"Hola, {firstName}:\",\n        \"Gracias por escribirnos{fromCompany}. Leímos tu mensaje sobre {service} y creemos que podemos ayudarte.\",\n        \"Por lo que nos cuentas, lo mejor es conversarlo: te llamaremos en menos de 24 horas para entender tu proceso y proponerte un primer paso concreto.\",\n        \"Si quieres adelantar algo, responde a este correo con cualquier detalle o ejemplo que te parezca útil.\",\n        \"Un saludo,\\nAIM Desarrollo y Automatizaciones\"\n      ]\n    },\n    \"proposal\": {\n      \"subject\": \"{firstName}, preparamos tu propuesta de {service}\",\n      \"body\": [\n        \"Hola, {firstName}:\",\n        \"Gracias por escribirnos{fromCompany}. Ya revisamos lo que necesitas en {service}.\",\n        \"En las próximas 48 horas te enviaremos por correo una propuesta con alcance, tiempos y un estimado de inversión. Si algo no te cuadra, la ajustamos contigo.\",\n        \"Si mientras tanto se te ocurre algo más, solo responde a este correo.\",\n        \"Un saludo,\\nAIM Desarrollo y Automatizaciones\"\n      ]\n    },\n    \"nurture\": {\n      \"subject\": \"{firstName}, gracias por tu interés en {service}\",\n      \"body\": [\n        \"Hola, {firstName}:\",\n        \"Gracias por escribirnos{fromCompany}. Nos alegra que estés pensando en {service}.\",\n        \"Para que des el siguiente paso con calma, en los próximos días te compartiremos contenido útil: ejemplos, preguntas frecuentes y buenas prácticas.\",\n        \"Cuando quieras conversar, responde a este correo y lo agendamos.\",\n        \"Un saludo,\\nAIM Desarrollo y Automatizaciones\"\n      ]\n    }\n  }\n}\n",
        "options": {}
      },
