{
  // Static site on Cloudflare Pages (DEC-007): aimweb.pages.dev until the aimweb.dev domain is connected.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aimweb",
  "compatibility_date": "2026-10-01",
  // pg (Neon) needs Node APIs and TCP sockets in the /api Pages Function.
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  // Workers AI (DEC-018): the free model of the Lab assistant. No API key: the binding uses this account.
  "ai": { "binding": "AI" },
  // Non-secret settings of the /api function. Secrets (DATABASE_URL, JWT_SECRET, TURNSTILE_SECRET,
  // RESEND_API_KEY) are set with `wrangler pages secret put` (docs/DESPLIEGUE.md).
  "vars": {
    "APP_ENV": "production",
    "SITE_ORIGIN": "https://aimweb-9hc.pages.dev",
    "ADMIN_EMAILS": "dacty2003@gmail.com",
    "MAIL_FROM": "AIM <onboarding@resend.dev>",
    "NOTIFY_TO": "dacty2003@gmail.com",
    // About 150 assistant messages fit in the free 10,000 neurons a day; 120 leaves room.
    "ASSISTANT_DAILY_LIMIT": "120",
    // Each /api/lab/burst request takes ~1 s (new Neon connection), so a 10 s window never fills: 10 per minute does.
    "LAB_BURST_WINDOW_SECONDS": "60"
  }
}
