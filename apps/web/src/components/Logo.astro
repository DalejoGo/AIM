---
import { site } from '../lib/site'

interface Props {
  size?: number
  /** Adds "Desarrollo y Automatizaciones" under the name, so the header reads the official name (DEC-001). */
  descriptor?: boolean
}

// David's logo (assets/brand): the light version on the light theme, the neon one on the dark theme.
// Decorative here: the brand name next to it is the accessible text.
const { size = 36, descriptor = false } = Astro.props
const width = Math.round(size * 0.9)
// The logo is drawn at 28-36 px: the 64 px tall file covers screens up to 2x, the 128 px one sharper screens.
const files = (theme: 'light' | 'dark', width64: number, width128: number) =>
  `/brand/aim-logo-${theme}-64.webp ${width64}w, /brand/aim-logo-${theme}.webp ${width128}w`
const sizes = `${width}px`
---

<span class:list={['inline-flex items-center', descriptor ? 'gap-2' : 'gap-2.5']}>
  <img
    src="/brand/aim-logo-light-64.webp"
    srcset={files('light', 57, 114)}
    sizes={sizes}
    alt=""
    width={width}
    height={size}
    class="shrink-0 dark:hidden"
    decoding="async"
  />
  <img
    src="/brand/aim-logo-dark-64.webp"
    srcset={files('dark', 60, 119)}
    sizes={sizes}
    alt=""
    width={width}
    height={size}
    class="hidden shrink-0 dark:block"
    decoding="async"
  />
  {
    descriptor ? (
      <span class="grid leading-none">
        {/* The trailing space keeps "AIM Desarrollo…" as words for screen readers and the link's name. */}
        <span class="font-display text-[1.15rem] font-semibold tracking-tight">{`${site.brand.name} `}</span>
        {/* Two short lines on phones and tablets, one line on desktop; hidden below 360 px where it cannot fit. */}
        <span class="mt-1 max-w-[5.75rem] text-[0.64rem] leading-tight text-muted max-[359px]:hidden lg:max-w-none lg:whitespace-nowrap lg:text-[0.72rem]">
          {site.brand.descriptor}
        </span>
      </span>
    ) : (
      <span class="font-display text-[1.15rem] font-semibold tracking-tight">{site.brand.name}</span>
    )
  }
</span>
