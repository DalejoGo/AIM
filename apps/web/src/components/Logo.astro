---
import { site } from '../lib/site'

interface Props {
  size?: number
}

// David's logo (assets/brand): the light version on the light theme, the neon one on the dark theme.
// Decorative here: the brand name next to it is the accessible text.
const { size = 36 } = Astro.props
const width = Math.round(size * 0.9)
---

<span class="inline-flex items-center gap-2.5">
  <img src="/brand/aim-logo-light.webp" alt="" width={width} height={size} class="shrink-0 dark:hidden" decoding="async" />
  <img
    src="/brand/aim-logo-dark.webp"
    alt=""
    width={width}
    height={size}
    class="hidden shrink-0 dark:block"
    decoding="async"
  />
  <span class="font-display text-[1.15rem] font-semibold tracking-tight">{site.brand.name}</span>
</span>
