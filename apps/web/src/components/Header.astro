---
import { CURRENCIES } from '@aim/contracts'
import { Menu, Moon, Sun } from '@lucide/astro'
import { es } from '../i18n/es'
import { site } from '../lib/site'
import Logo from './Logo.astro'

const links = [
  { href: '/servicios/', label: es.nav.services },
  { href: '/proyectos/', label: es.nav.projects },
  { href: '/lab/', label: es.nav.lab },
  { href: '/sobre-mi/', label: es.nav.about },
]
const current = Astro.url.pathname
const isCurrent = (href: string) => current.startsWith(href)
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center gap-3">
    <a href="/" class="shrink-0 rounded-md no-underline" aria-label={`${site.brand.fullName}, ir al inicio`}>
      <Logo size={32} descriptor />
    </a>

    <nav aria-label={es.nav.label} class="ml-6 hidden lg:block">
      <ul class="flex gap-6 text-step--1">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
                class:list={[
                  'no-underline hover:text-text',
                  isCurrent(l.href) ? 'font-semibold text-text' : 'text-muted',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <div role="group" aria-label={es.prefs.currency} class="flex rounded-lg border border-line p-0.5 text-step--1">
        {
          CURRENCIES.map((c) => (
            <button
              type="button"
              data-currency-option={c}
              class="rounded-md px-1.5 py-1 font-semibold text-muted aria-pressed:bg-brand aria-pressed:text-brand-contrast sm:px-2"
              aria-pressed="false"
            >
              {c}
            </button>
          ))
        }
      </div>
      <button
        type="button"
        id="theme-toggle"
        class="grid size-9 place-items-center rounded-lg border border-line text-muted hover:text-text"
        aria-label={es.prefs.theme}
      >
        <Sun size={18} class="hidden dark:block" aria-hidden="true" />
        <Moon size={18} class="block dark:hidden" aria-hidden="true" />
      </button>
      <a href="/cotizar/" class="btn btn-primary hidden min-h-9 py-1.5 text-step--1 sm:inline-flex">{es.nav.quote}</a>

      <details class="relative lg:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-lg border border-line text-muted [&::-webkit-details-marker]:hidden"
          aria-label={es.nav.menu}
        >
          <Menu size={18} aria-hidden="true" />
        </summary>
        <nav
          aria-label={es.nav.label}
          class="absolute right-0 top-12 w-56 rounded-xl border border-line bg-raised p-2 shadow-lg"
        >
          <ul class="grid">
            {
              [...links, { href: '/cotizar/', label: es.nav.quote }].map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={isCurrent(l.href) ? 'page' : undefined}
                    class="block rounded-lg px-3 py-2.5 no-underline hover:bg-ink"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import type { Currency } from '@aim/contracts'
  import { getCurrency, getTheme, setCurrency, setTheme } from '../lib/preferences'

  const options = document.querySelectorAll<HTMLButtonElement>('[data-currency-option]')
  const paint = () => {
    for (const o of options) o.setAttribute('aria-pressed', String(o.dataset.currencyOption === getCurrency()))
  }
  for (const o of options) {
    o.addEventListener('click', () => {
      setCurrency(o.dataset.currencyOption as Currency)
      paint()
    })
  }
  paint()

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    setTheme(getTheme() === 'dark' ? 'light' : 'dark')
  })
</script>
