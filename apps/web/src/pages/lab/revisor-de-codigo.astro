---
import LabShell from '../../components/LabShell.astro'
import { CodeReview } from '../../features/code-review/CodeReview'
import { turnstileSiteKey, whatsapp } from '../../lib/site'
---

<LabShell slug="revisor-de-codigo">
  <noscript>
    <p class="prose-measure rounded-xl border border-line bg-raised p-4">
      El revisor necesita JavaScript para enviar tu código y mostrar la revisión. Actívalo y recarga la página, o
      <a href={whatsapp()} class="link">escríbele a David por WhatsApp</a>.
    </p>
  </noscript>
  <CodeReview client:load turnstileSiteKey={turnstileSiteKey()} whatsappUrl={whatsapp()} />
</LabShell>
