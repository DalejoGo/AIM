---
import { getCollection } from 'astro:content'
import ContactCta from '../../components/ContactCta.astro'
import LabList from '../../components/LabList.astro'
import Base from '../../layouts/Base.astro'
import { site } from '../../lib/site'

const certificates = await getCollection('certificates')
const hours = certificates.reduce((sum, c) => sum + (c.data.hours ?? 0), 0)
---

<Base title="Lab" description="Demos en vivo del stack de AIM: cada certificación se convierte en algo que puedes usar.">
  <section class="wrap pt-12 md:pt-16">
    <h1 class="text-step-4 font-semibold md:text-step-5">Lab</h1>
    <p class="prose-measure mt-4 text-step-1 text-muted">
      Aquí no te cuento lo que sé hacer: te lo muestro. Cada demo nace de una certificación o de un problema real, y las
      que corren en tu navegador no envían tus datos a ningún lado.
    </p>
    <p class="mt-4 text-step--1 text-muted">
      {certificates.length} certificaciones y {hours} horas de formación detrás. Cada mes se suman demos nuevas.
    </p>
    <div class="mt-12">
      <LabList />
    </div>
    {
      site.contact.platzi && (
        <p class="mt-8 text-step--1 text-muted">
          Puedes verificar mis certificados en mi <a href={site.contact.platzi} class="link" rel="noopener">perfil de Platzi</a> o
          verlos en <a href="/sobre-mi/#certificados" class="link">Sobre mí</a>.
        </p>
      )
    }
  </section>
  <ContactCta title="¿Quieres algo así en tu negocio?" />
</Base>
