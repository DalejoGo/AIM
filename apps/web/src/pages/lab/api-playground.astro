---
import LabShell from '../../components/LabShell.astro'
import { ApiPlayground } from '../../features/api-playground/ApiPlayground'
import { docsUrl, playgroundApiUrl } from '../../features/api-playground/config'

// Build time (CLAUDE.md rule 4): the deploy script sets it to the API on Render. Without it the page still
// builds and explains that the console is not available, with no JavaScript to load.
const apiUrl = playgroundApiUrl(import.meta.env.PUBLIC_PLAYGROUND_API_URL)
---

<LabShell slug="api-playground">
  {
    apiUrl ? (
      <>
        <noscript>
          <p class="prose-measure rounded-xl border border-line bg-raised p-4">
            Esta consola necesita JavaScript: tu navegador envía las peticiones a la API y muestra las respuestas.
            Actívalo y recarga la página, o mira los endpoints en la{' '}
            <a href={docsUrl(apiUrl)} class="link">
              documentación de la API
            </a>
            .
          </p>
        </noscript>
        <ApiPlayground client:load apiUrl={apiUrl} />
      </>
    ) : (
      <ApiPlayground apiUrl={null} />
    )
  }
</LabShell>
