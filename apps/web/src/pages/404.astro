---
import Base from '../layouts/Base.astro'
---

<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección.">
  <section class="wrap grid min-h-[60dvh] content-center gap-6 py-16">
    <h1 class="text-step-4 font-semibold md:text-step-5">Esta página no existe</h1>
    <p class="prose-measure text-step-1 text-muted">Puede que el enlace esté mal escrito o que la página haya cambiado de dirección.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/servicios/" class="btn btn-quiet">Ver servicios</a>
    </div>
  </section>
</Base>
