---
import { getCollection, render } from 'astro:content'
import ContactCta from '../../components/ContactCta.astro'
import { es } from '../../i18n/es'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.public)
  return projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))
}

const { entry } = Astro.props
const p = entry.data
const { Content } = await render(entry)
---

<Base
  title={p.title}
  description={p.summary}
  jsonLd={[{ '@type': 'CreativeWork', name: p.title, description: p.summary, dateCreated: String(p.year) }]}
>
  <article class="wrap pt-12 md:pt-16">
    <nav aria-label="Migas de pan" class="text-step--1 text-muted">
      <a href="/proyectos/" class="hover:text-text">{es.nav.projects}</a>
    </nav>
    <header class="mt-4 grid gap-4">
      <h1 class="max-w-[22ch] text-step-4 font-semibold md:text-step-5">{p.title}</h1>
      <p class="prose-measure text-step-1 text-muted">{p.summary}</p>
    </header>

    <dl class="mt-10 grid gap-6 border-y border-line py-6 text-step--1 sm:grid-cols-3">
      <div><dt class="text-muted">Mi rol</dt><dd class="mt-1">{p.role}</dd></div>
      <div><dt class="text-muted">Año</dt><dd class="mt-1">{p.year}</dd></div>
      <div><dt class="text-muted">Tecnologías</dt><dd class="mt-1">{p.stack.join(', ')}</dd></div>
    </dl>

    <div class="mt-12 grid gap-12 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <div class="grid content-start gap-10">
        <section aria-labelledby="reto" class="grid gap-3">
          <h2 id="reto" class="text-step-2 font-semibold">El reto</h2>
          <p class="prose-measure">{p.challenge}</p>
        </section>
        <section aria-labelledby="solucion" class="grid gap-3">
          <h2 id="solucion" class="text-step-2 font-semibold">La solución</h2>
          <p class="prose-measure">{p.solution}</p>
        </section>
        <div class="prose-measure text-muted [&_p]:mt-3">
          <Content />
        </div>
      </div>
      <aside class="grid content-start gap-8">
        <section aria-labelledby="resultados" class="rounded-2xl border border-line bg-raised p-6">
          <h2 id="resultados" class="text-step-1 font-semibold">Resultados verificables</h2>
          <ul class="mt-4 grid gap-3 text-step--1">
            {
              p.results.map((r) => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-live" aria-hidden="true" />
                  {r}
                </li>
              ))
            }
          </ul>
        </section>
        {
          p.highlights.length > 0 && (
            <section aria-labelledby="destacado">
              <h2 id="destacado" class="text-step-1 font-semibold">También incluye</h2>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-step--1 text-muted marker:text-brand">
                {p.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </article>
  <ContactCta title="¿Algo parecido para tu negocio?" />
</Base>
