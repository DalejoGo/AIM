{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PyLabHealth",
  "$defs": {
    "PyLabHealth": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "version": {
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/PyLabLimits"
        }
      },
      "required": [
        "status",
        "version",
        "limits"
      ],
      "additionalProperties": false
    },
    "PyLabLimits": {
      "type": "object",
      "properties": {
        "maxUploadBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxColumns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCells": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "csv",
              "xls",
              "xlsx"
            ]
          }
        }
      },
      "required": [
        "maxUploadBytes",
        "maxRows",
        "maxColumns",
        "maxCells",
        "formats"
      ],
      "additionalProperties": false
    }
  }
}
