# --- Web (apps/web) ---
# Public base URL of the site; no host is hard-coded anywhere (DEC-007).
PUBLIC_BASE_URL=http://localhost:4321
# Production today: https://aimweb-9hc.pages.dev (https://aimweb.dev once the domain is connected).
# WhatsApp number in international format, digits only.
PUBLIC_WHATSAPP_NUMBER=573027015524
# development | staging | production
APP_ENV=development
# Cloudflare Web Analytics token (public; only production builds load the beacon, DEC-020).
# PUBLIC_CF_ANALYTICS_TOKEN=
# Cloudflare Turnstile site key (public) for the contact form, the cotizador and the /admin/ login.
# Empty outside production: the always-pass test key 1x00000000000000000000AA is used. Required with
# APP_ENV=production (the build fails without it). The secret key is a Pages secret (docs/DESPLIEGUE.md).
PUBLIC_TURNSTILE_SITE_KEY=
# Optional. Public URL of the API Playground (NestJS on Render, DEC-014), e.g. https://<service>.onrender.com.
# When set, its origin is added to the CSP connect-src at build time (apps/web/src/lib/csp.ts); empty, the
# site may only call its own /api. Must be an absolute http(s) URL or the build fails.
PUBLIC_PLAYGROUND_API_URL=

# --- API Playground (apps/api, NestJS on Render) ---
# Render sets PORT; locally API_PORT (then 3000) is used.
API_PORT=3000
# Requests per minute per IP for the whole API.
API_RATE_LIMIT=60
# Comma-separated origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:4321

# --- Local services (docker-compose.yml) ---
DATABASE_URL=postgres://aim:aim@127.0.0.1:54321/aim
REDIS_URL=redis://127.0.0.1:6381
SMTP_URL=smtp://127.0.0.1:1026

# --- Asistente IA (DEC-018): free Workers AI (Gemma 4) through the AI binding in wrangler.jsonc ---
# Optional: with an Anthropic key the assistant switches to Claude. Set it with `wrangler pages secret put`.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=@cf/google/gemma-4-26b-a4b-it
ASSISTANT_MAX_TOKENS=500
# Output cap of each code review (Lab "Revisor de código"); it shares the session and limits below.
ASSISTANT_REVIEW_MAX_TOKENS=800
ASSISTANT_MESSAGES_PER_HOUR=15
ASSISTANT_DAILY_LIMIT=300

# --- Lab "Seguridad en acción" (rate-limit demo, GET /api/lab/burst) ---
LAB_BURST_LIMIT=10
LAB_BURST_WINDOW_SECONDS=60
