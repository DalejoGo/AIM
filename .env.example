# --- Web (apps/web) ---
# Public base URL of the site; no host is hard-coded anywhere (DEC-007).
PUBLIC_BASE_URL=http://localhost:4321
# Production today: https://aimweb-9hc.pages.dev (https://aimweb.dev once the domain is connected).
# WhatsApp number in international format, digits only.
PUBLIC_WHATSAPP_NUMBER=573027015524
# development | staging | production
APP_ENV=development
# Cloudflare Web Analytics token (public; only production builds load the beacon, DEC-020).
# PUBLIC_CF_ANALYTICS_TOKEN=
# Cloudflare Turnstile site key (public) for the contact form, the cotizador and the /admin/ login.
# Empty outside production: the always-pass test key 1x00000000000000000000AA is used. Required with
# APP_ENV=production (the build fails without it). The secret key is a Pages secret (docs/DESPLIEGUE.md).
PUBLIC_TURNSTILE_SITE_KEY=
# Optional. Public URL of the API Playground (NestJS on Render, DEC-014), e.g. https://<service>.onrender.com.
# When set, its origin is added to the CSP connect-src at build time (apps/web/src/lib/csp.ts); empty, the
# site may only call its own /api. Must be an absolute http(s) URL or the build fails.
PUBLIC_PLAYGROUND_API_URL=
# Optional. Public URL of the data migrator's Python engine (services/py-lab, FastAPI on Render), e.g.
# https://aimweb-pylab.onrender.com, or http://localhost:8000 with `pnpm --filter @aim/py-lab serve`. When set,
# the migrator offers "En el servidor" and its origin joins the CSP connect-src; empty, only the browser engine.
PUBLIC_PYLAB_API_URL=

# --- API Playground (apps/api, NestJS on Render) ---
# Render sets PORT; locally API_PORT (then 3000) is used.
API_PORT=3000
# Requests per minute per IP for the whole API.
API_RATE_LIMIT=60
# Comma-separated origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:4321

# --- Data migrator, Python engine (services/py-lab, FastAPI on Render; README.md there) ---
# Render sets PORT; locally `pnpm --filter @aim/py-lab serve` listens on 8000.
# Comma-separated origins allowed by CORS (the site). Empty: no browser can call it from another origin.
PYLAB_CORS_ORIGINS=http://localhost:4321
# Migrations per minute per visitor IP.
PYLAB_RATE_LIMIT=20
# Proxies in front that append to X-Forwarded-For (Render: 1; 0 when nothing is in front).
PYLAB_TRUSTED_PROXY_HOPS=1
# Limits of one upload (measured on 512 MB and 0.1 CPU, see the README).
PYLAB_MAX_UPLOAD_MB=10
PYLAB_MAX_ROWS=50000
PYLAB_MAX_COLUMNS=50
PYLAB_MAX_CELLS=300000
PYLAB_MAX_XLSX_UNCOMPRESSED_MB=100
# Files processed at once, and how long the next one waits in line before a 503.
PYLAB_MAX_CONCURRENT=1
PYLAB_QUEUE_WAIT_SECONDS=30
# Memory and time of the subprocess that reads Excel workbooks.
PYLAB_EXCEL_MEMORY_MB=256
PYLAB_EXCEL_TIMEOUT_SECONDS=90

# --- Local services (docker-compose.yml) ---
DATABASE_URL=postgres://aim:aim@127.0.0.1:54321/aim
REDIS_URL=redis://127.0.0.1:6381
SMTP_URL=smtp://127.0.0.1:1026

# --- Asistente IA (DEC-018): free Workers AI (Gemma 4) through the AI binding in wrangler.jsonc ---
# Optional: with an Anthropic key the assistant switches to Claude. Set it with `wrangler pages secret put`.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=@cf/google/gemma-4-26b-a4b-it
ASSISTANT_MAX_TOKENS=500
# Output cap of each code review (Lab "Revisor de código"); it shares the session and limits below.
ASSISTANT_REVIEW_MAX_TOKENS=800
ASSISTANT_MESSAGES_PER_HOUR=15
ASSISTANT_DAILY_LIMIT=300

# --- Lab "Seguridad en acción" (rate-limit demo, GET /api/lab/burst) ---
LAB_BURST_LIMIT=10
LAB_BURST_WINDOW_SECONDS=60

# --- Lab "Automatización en vivo" (edge, docs/AUTOMATIZACION.md) ---
# Base URL of the n8n that runs the flow: http://127.0.0.1:5679 locally (docker-compose.yml),
# https://aimweb-n8n.onrender.com in production (apps/web/wrangler.jsonc). Empty turns the demo off (503).
AUTOMATION_N8N_URL=http://127.0.0.1:5679
# Path of the flow's webhook: POST {AUTOMATION_N8N_URL}/webhook/{AUTOMATION_WEBHOOK_PATH}.
AUTOMATION_WEBHOOK_PATH=aim-lead-demo
# Runs for everyone in a rolling 24 hours.
AUTOMATION_DAILY_LIMIT=150
# How long a run waits for n8n to wake up (Render's free plan sleeps it). At most 40 subrequests per run.
AUTOMATION_WAKE_TIMEOUT_SECONDS=180
# Runs per visitor (IP hash) every AUTOMATION_BURST_WINDOW_SECONDS.
AUTOMATION_BURST_LIMIT=3
AUTOMATION_BURST_WINDOW_SECONDS=600
# n8n (automations/, Render service aimweb-n8n): origin of the site whose /api receives the flow's step reports.
# Local: docker-compose.yml sets http://host.docker.internal:8789 (the site + API of `pnpm dev:full`).
AIM_SITE_ORIGIN=https://aimweb-9hc.pages.dev
