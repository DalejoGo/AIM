# --- Web (apps/web) ---
# Public base URL of the site; no host is hard-coded anywhere (DEC-007).
PUBLIC_BASE_URL=http://localhost:4321
# Production today: https://aimweb-9hc.pages.dev (https://aimweb.dev once the domain is connected).
# WhatsApp number in international format, digits only.
PUBLIC_WHATSAPP_NUMBER=573027015524
# development | staging | production
APP_ENV=development
# Cloudflare Turnstile site key (public) for the contact form, the cotizador and the /admin/ login.
# Empty outside production: the always-pass test key 1x00000000000000000000AA is used. Required with
# APP_ENV=production (the build fails without it). The secret key is a Pages secret (docs/DESPLIEGUE.md).
PUBLIC_TURNSTILE_SITE_KEY=

# --- API Playground (apps/api, NestJS on Render) ---
# Render sets PORT; locally API_PORT (then 3000) is used.
API_PORT=3000
# Requests per minute per IP for the whole API.
API_RATE_LIMIT=60
# Comma-separated origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:4321

# --- Local services (docker-compose.yml) ---
DATABASE_URL=postgres://aim:aim@127.0.0.1:54321/aim
REDIS_URL=redis://127.0.0.1:6381
SMTP_URL=smtp://127.0.0.1:1026

# --- Asistente IA (optional; without the key /api/assistant/* answers 503) ---
# Local: a key with a low spending limit. Production: `wrangler pages secret put ANTHROPIC_API_KEY`.
# ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_MAX_TOKENS=500
ASSISTANT_MESSAGES_PER_HOUR=15
ASSISTANT_DAILY_LIMIT=300
